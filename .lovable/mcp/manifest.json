{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "world-wanderer",
      "version": "0.1.0",
      "title": "World Wanderer"
    },
    "tools": [
      {
        "name": "list_quests",
        "title": "List published quests",
        "description": "List published quests (photo adventures) with title, mode and creation date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "solo",
                "multiplayer",
                "treasure_hunt"
              ],
              "description": "Filter by quest mode."
            },
            "search": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Case-insensitive title search."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum quests to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_quest",
        "title": "Get quest details",
        "description": "Get a published quest with its public task hints (hidden scoring criteria are never returned).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quest_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID of the quest."
            }
          },
          "required": [
            "quest_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_quest_leaderboard",
        "title": "Get quest leaderboard",
        "description": "Get the public leaderboard (rank, nickname, score, duration) for a quest.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "quest_id": {
              "type": "string",
              "format": "uuid",
              "description": "ID of the quest."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10,
              "description": "How many entries to return."
            }
          },
          "required": [
            "quest_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
